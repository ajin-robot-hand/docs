{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":[" "],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Robot Hand \ud300 \ube14\ub85c\uadf8","text":"<p>\uc774 \uc0ac\uc774\ud2b8\ub294 \ud300\uc6d0\ub4e4\uc774 \uac01\uc790 \uc9c4\ud589\ud55c \uc791\uc5c5, \ud559\uc2b5 \ub0b4\uc6a9, \ud2b8\ub7ec\ube14\uc288\ud305 \uacbd\ud5d8\uc744 \uae30\ub85d\ud558\ub294 \uacf5\uac04\uc785\ub2c8\ub2e4.</p> <ul> <li>\ucd5c\uadfc \uae00\uc740 \ube14\ub85c\uadf8 \ud0ed\uc5d0\uc11c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</li> <li>\uc0c8 \uae00\uc744 \uc791\uc131\ud558\ub824\uba74 <code>docs/blog/posts/</code> \uc544\ub798\uc5d0 \ub9c8\ud06c\ub2e4\uc6b4 \ud30c\uc77c\uc744 \ucd94\uac00\ud558\uc138\uc694. \uc790\uc138\ud55c \ubc29\ubc95\uc740 \uc800\uc7a5\uc18c\uc758 <code>docs/blog/posts/how-to-write.md</code> \uc608\uc2dc \uae00\uc744 \ucc38\uace0\ud558\uc138\uc694.</li> </ul>"},{"location":"blog/","title":"\ube14\ub85c\uadf8","text":"<p>\ud300\uc6d0\ub4e4\uc774 \uc791\uc131\ud55c \uae00 \ubaa9\ub85d\uc785\ub2c8\ub2e4.</p>"},{"location":"blog/2026/08/%ED%8C%80-%EB%B8%94%EB%A1%9C%EA%B7%B8%EB%A5%BC-%EC%8B%9C%EC%9E%91%ED%95%A9%EB%8B%88%EB%8B%A4/","title":"\ud300 \ube14\ub85c\uadf8\ub97c \uc2dc\uc791\ud569\ub2c8\ub2e4","text":"<p>\uc774 \uae00\uc740 \ud300 \ube14\ub85c\uadf8\uc758 \uccab \ubc88\uc9f8 \uc608\uc2dc \uae00\uc785\ub2c8\ub2e4. \ud300\uc6d0\ub4e4\uc740 \uc774 \ud615\uc2dd\uc744 \ucc38\uace0\ud574\uc11c \uac01\uc790 \uc9c4\ud589\ud55c \uc791\uc5c5\uc744 \uae30\ub85d\ud558\uba74 \ub429\ub2c8\ub2e4.</p>"},{"location":"blog/2026/08/%ED%8C%80-%EB%B8%94%EB%A1%9C%EA%B7%B8%EB%A5%BC-%EC%8B%9C%EC%9E%91%ED%95%A9%EB%8B%88%EB%8B%A4/#_2","title":"\uc0c8 \uae00 \uc791\uc131 \ubc29\ubc95","text":"<ol> <li><code>docs/blog/posts/</code> \uc544\ub798\uc5d0 <code>YYYY-MM-DD-\uc81c\ubaa9.md</code> \ud615\uc2dd\uc73c\ub85c \ud30c\uc77c\uc744 \ub9cc\ub4dc\uc138\uc694.</li> <li>\ud30c\uc77c \uc0c1\ub2e8\uc5d0 \uc544\ub798\uc640 \uac19\uc740 front matter\ub97c \uc791\uc131\ud558\uc138\uc694.</li> </ol> <pre><code>---\ndate: 2026-08-12\ncategories:\n  - &lt;\ubcf8\uc778 author id&gt;   # docs/blog/.authors.yml \uc5d0 \ub4f1\ub85d\ub41c id\nauthors:\n  - &lt;\ubcf8\uc778 author id&gt;\n---\n</code></pre> <ol> <li><code>categories</code>\uc5d0 \ubcf8\uc778\uc758 author id\ub97c \ub123\uc73c\uba74, \uc0ac\uc774\ud2b8\uc758 \"\uc791\uc131\uc790\" \uce74\ud14c\uace0\ub9ac \ud398\uc774\uc9c0\uc5d0\uc11c \ud2b9\uc815 \ud300\uc6d0\uc774 \uc4f4 \uae00\ub9cc \ubaa8\uc544\ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4.</li> <li><code>&lt;!-- more --&gt;</code> \uc704\ucabd \ub0b4\uc6a9\uc740 \ubaa9\ub85d \ud398\uc774\uc9c0\uc5d0 \ubbf8\ub9ac\ubcf4\uae30\ub85c \ub178\ucd9c\ub429\ub2c8\ub2e4.</li> <li>\uc544\uc9c1 <code>docs/blog/.authors.yml</code>\uc5d0 \ubcf8\uc778 \ud504\ub85c\ud544\uc774 \uc5c6\ub2e4\uba74 \ucd94\uac00\ud55c \ub4a4 \ucee4\ubc0b\ud558\uc138\uc694.</li> </ol>"},{"location":"blog/2026/08/%ED%8C%80-%EB%B8%94%EB%A1%9C%EA%B7%B8%EB%A5%BC-%EC%8B%9C%EC%9E%91%ED%95%A9%EB%8B%88%EB%8B%A4/#_3","title":"\ub85c\uceec\uc5d0\uc11c \ubbf8\ub9ac\ubcf4\uae30","text":"<pre><code>pip install -r requirements.txt\nmkdocs serve\n</code></pre> <p><code>http://127.0.0.1:8000</code> \uc5d0\uc11c \uacb0\uacfc\ub97c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p>"},{"location":"blog/2026/08/%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8-%EA%B3%84%ED%9A%8D%EC%84%9C-ppt/","title":"\ud504\ub85c\uc81d\ud2b8 \uacc4\ud68d\uc11c PPT","text":"<p>8.12 \uccab \ubbf8\ud305</p>"},{"location":"blog/2026/08/%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8-%EA%B3%84%ED%9A%8D%EC%84%9C-ppt/#3","title":"\ud83d\udcca 3\uc9c0 \ub85c\ubd07 \ud578\ub4dc \uac1c\ubc1c \uacc4\ud68d\uc11c","text":"\u2197\ufe0f \uc0c8 \ucc3d\uc5d0\uc11c \uc804\uccb4 \ud654\uba74\uc73c\ub85c \ubcf4\uae30"},{"location":"blog/2026/08/%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8-%EA%B3%84%ED%9A%8D%EC%84%9C-ppt/#_1","title":"\ud83d\udccc \uc8fc\uc694 \ub0b4\uc6a9 \uc694\uc57d","text":"<ul> <li>1~2\ud398\uc774\uc9c0: 7\uc790\uc720\ub3c4 3\uc9c0 \ub85c\ubd07 \ud578\ub4dc \uac1c\ubc1c \ud504\ub85c\uc81d\ud2b8 \uac1c\uc694 \ubc0f \uc8fc\uc694 \ubaa9\ud45c</li> <li>3~4\ud398\uc774\uc9c0: 3\uc9c0 \ub85c\ubd07 \uc120\ud0dd \uc774\uc720\uc640 \ud30c\uc9c0 \uc131\uacf5\ub960 \ubc0f \uc2dc\uc2a4\ud15c \uac00\uc6a9\ub960 \ubaa9\ud45c</li> <li>5~6\ud398\uc774\uc9c0: \ud3c9\uac00 \uc9c0\ud45c(KPI) \ubc0f XL430 \uc561\ucd94\uc5d0\uc774\ud130 \uae30\ubc18 \uc138\ubd80 \uc81c\ud488 \uc0ac\uc591</li> <li>7~8\ud398\uc774\uc9c0: \uc2dc\uc2a4\ud15c \uc544\ud0a4\ud14d\ucc98 \uad6c\uc131 \ubc0f 8\uac1c\uc6d4 \uac1c\ubc1c \ub85c\ub4dc\ub9f5</li> </ul>"},{"location":"blog/archive/2026/","title":"2026","text":""},{"location":"blog/category/erdoslibrary/","title":"erdoslibrary","text":""},{"location":"blog/category/yeonjunky/","title":"yeonjunky","text":""}]}