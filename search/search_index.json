{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":[" "],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Robot Hand \ud300 \ube14\ub85c\uadf8","text":"<p>\uc774 \uc0ac\uc774\ud2b8\ub294 \ud300\uc6d0\ub4e4\uc774 \uac01\uc790 \uc9c4\ud589\ud55c \uc791\uc5c5, \ud559\uc2b5 \ub0b4\uc6a9, \ud2b8\ub7ec\ube14\uc288\ud305 \uacbd\ud5d8\uc744 \uae30\ub85d\ud558\ub294 \uacf5\uac04\uc785\ub2c8\ub2e4.</p> <ul> <li>\ucd5c\uadfc \uae00\uc740 \ube14\ub85c\uadf8 \ud0ed\uc5d0\uc11c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</li> <li>\uc0c8 \uae00\uc744 \uc791\uc131\ud558\ub824\uba74 <code>docs/blog/posts/</code> \uc544\ub798\uc5d0 \ub9c8\ud06c\ub2e4\uc6b4 \ud30c\uc77c\uc744 \ucd94\uac00\ud558\uc138\uc694. \uc790\uc138\ud55c \ubc29\ubc95\uc740 \uc800\uc7a5\uc18c\uc758 <code>docs/blog/posts/how-to-write.md</code> \uc608\uc2dc \uae00\uc744 \ucc38\uace0\ud558\uc138\uc694.</li> </ul>"},{"location":"blog/","title":"\ube14\ub85c\uadf8","text":"<p>\ud300\uc6d0\ub4e4\uc774 \uc791\uc131\ud55c \uae00 \ubaa9\ub85d\uc785\ub2c8\ub2e4.</p>"},{"location":"blog/2026/08/%ED%8C%80-%EB%B8%94%EB%A1%9C%EA%B7%B8%EB%A5%BC-%EC%8B%9C%EC%9E%91%ED%95%A9%EB%8B%88%EB%8B%A4/","title":"\ud300 \ube14\ub85c\uadf8\ub97c \uc2dc\uc791\ud569\ub2c8\ub2e4","text":"<p>\uc774 \uae00\uc740 \ud300 \ube14\ub85c\uadf8\uc758 \uccab \ubc88\uc9f8 \uc608\uc2dc \uae00\uc785\ub2c8\ub2e4. \ud300\uc6d0\ub4e4\uc740 \uc774 \ud615\uc2dd\uc744 \ucc38\uace0\ud574\uc11c \uac01\uc790 \uc9c4\ud589\ud55c \uc791\uc5c5\uc744 \uae30\ub85d\ud558\uba74 \ub429\ub2c8\ub2e4.</p>"},{"location":"blog/2026/08/%ED%8C%80-%EB%B8%94%EB%A1%9C%EA%B7%B8%EB%A5%BC-%EC%8B%9C%EC%9E%91%ED%95%A9%EB%8B%88%EB%8B%A4/#_2","title":"\uc0c8 \uae00 \uc791\uc131 \ubc29\ubc95","text":"<ol> <li><code>docs/blog/posts/</code> \uc544\ub798\uc5d0 <code>YYYY-MM-DD-\uc81c\ubaa9.md</code> \ud615\uc2dd\uc73c\ub85c \ud30c\uc77c\uc744 \ub9cc\ub4dc\uc138\uc694.</li> <li>\ud30c\uc77c \uc0c1\ub2e8\uc5d0 \uc544\ub798\uc640 \uac19\uc740 front matter\ub97c \uc791\uc131\ud558\uc138\uc694.</li> </ol> <pre><code>---\ndate: 2026-08-12\ncategories:\n  - &lt;\ubcf8\uc778 author id&gt;   # docs/blog/.authors.yml \uc5d0 \ub4f1\ub85d\ub41c id\nauthors:\n  - &lt;\ubcf8\uc778 author id&gt;\n---\n</code></pre> <ol> <li><code>categories</code>\uc5d0 \ubcf8\uc778\uc758 author id\ub97c \ub123\uc73c\uba74, \uc0ac\uc774\ud2b8\uc758 \"\uc791\uc131\uc790\" \uce74\ud14c\uace0\ub9ac \ud398\uc774\uc9c0\uc5d0\uc11c \ud2b9\uc815 \ud300\uc6d0\uc774 \uc4f4 \uae00\ub9cc \ubaa8\uc544\ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4.</li> <li><code>&lt;!-- more --&gt;</code> \uc704\ucabd \ub0b4\uc6a9\uc740 \ubaa9\ub85d \ud398\uc774\uc9c0\uc5d0 \ubbf8\ub9ac\ubcf4\uae30\ub85c \ub178\ucd9c\ub429\ub2c8\ub2e4.</li> <li>\uc544\uc9c1 <code>docs/blog/.authors.yml</code>\uc5d0 \ubcf8\uc778 \ud504\ub85c\ud544\uc774 \uc5c6\ub2e4\uba74 \ucd94\uac00\ud55c \ub4a4 \ucee4\ubc0b\ud558\uc138\uc694.</li> </ol>"},{"location":"blog/2026/08/%ED%8C%80-%EB%B8%94%EB%A1%9C%EA%B7%B8%EB%A5%BC-%EC%8B%9C%EC%9E%91%ED%95%A9%EB%8B%88%EB%8B%A4/#_3","title":"\ub85c\uceec\uc5d0\uc11c \ubbf8\ub9ac\ubcf4\uae30","text":"<pre><code>pip install -r requirements.txt\nmkdocs serve\n</code></pre> <p><code>http://127.0.0.1:8000</code> \uc5d0\uc11c \uacb0\uacfc\ub97c \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p>"},{"location":"blog/2026/08/%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8-%EA%B3%84%ED%9A%8D%EC%84%9C-ppt/","title":"\ud504\ub85c\uc81d\ud2b8 \uacc4\ud68d\uc11c PPT","text":"<p>8.12 \uccab \ubbf8\ud305</p>"},{"location":"blog/2026/08/%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8-%EA%B3%84%ED%9A%8D%EC%84%9C-ppt/#3","title":"\ud83d\udcca 3\uc9c0 \ub85c\ubd07 \ud578\ub4dc \uac1c\ubc1c \uacc4\ud68d\uc11c","text":"\u2197\ufe0f \uc0c8 \ucc3d\uc5d0\uc11c \uc804\uccb4 \ud654\uba74\uc73c\ub85c \ubcf4\uae30"},{"location":"blog/2026/08/%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8-%EA%B3%84%ED%9A%8D%EC%84%9C-ppt/#_1","title":"\ud83d\udccc \uc8fc\uc694 \ub0b4\uc6a9 \uc694\uc57d","text":"<ul> <li>1~2\ud398\uc774\uc9c0: 7\uc790\uc720\ub3c4 3\uc9c0 \ub85c\ubd07 \ud578\ub4dc \uac1c\ubc1c \ud504\ub85c\uc81d\ud2b8 \uac1c\uc694 \ubc0f \uc8fc\uc694 \ubaa9\ud45c</li> <li>3~4\ud398\uc774\uc9c0: 3\uc9c0 \ub85c\ubd07 \uc120\ud0dd \uc774\uc720\uc640 \ud30c\uc9c0 \uc131\uacf5\ub960 \ubc0f \uc2dc\uc2a4\ud15c \uac00\uc6a9\ub960 \ubaa9\ud45c</li> <li>5~6\ud398\uc774\uc9c0: \ud3c9\uac00 \uc9c0\ud45c(KPI) \ubc0f XL430 \uc561\ucd94\uc5d0\uc774\ud130 \uae30\ubc18 \uc138\ubd80 \uc81c\ud488 \uc0ac\uc591</li> <li>7~8\ud398\uc774\uc9c0: \uc2dc\uc2a4\ud15c \uc544\ud0a4\ud14d\ucc98 \uad6c\uc131 \ubc0f 8\uac1c\uc6d4 \uac1c\ubc1c \ub85c\ub4dc\ub9f5</li> </ul>"},{"location":"blog/2026/08/%EC%A7%80%EB%82%9C-2%EC%A3%BC-%EC%8B%A4%EC%A0%9C-dynamixel-%EC%A0%9C%EC%96%B4-%EA%B8%B0%EB%B0%98%EA%B3%BC-%ED%95%98%EB%93%9C%EC%9B%A8%EC%96%B4-%EC%97%86%EB%8A%94-%ED%85%8C%EC%8A%A4%ED%8A%B8-%ED%99%98%EA%B2%BD-%EB%A7%8C%EB%93%A4%EA%B8%B0/","title":"\uc9c0\ub09c 2\uc8fc: \uc2e4\uc81c Dynamixel \uc81c\uc5b4 \uae30\ubc18\uacfc \ud558\ub4dc\uc6e8\uc5b4 \uc5c6\ub294 \ud14c\uc2a4\ud2b8 \ud658\uacbd \ub9cc\ub4e4\uae30","text":"<p>\uc9c0\ub09c 2\uc8fc(8\uc6d4 12\uc77c~26\uc77c)\uc5d0 util-scripts\uc640 MockPortHandler\uc5d0 \ub2e4\uc74c \uc791\uc5c5\uc744 \ubc18\uc601\ud588\uc2b5\ub2c8\ub2e4.</p>"},{"location":"blog/2026/08/%EC%A7%80%EB%82%9C-2%EC%A3%BC-%EC%8B%A4%EC%A0%9C-dynamixel-%EC%A0%9C%EC%96%B4-%EA%B8%B0%EB%B0%98%EA%B3%BC-%ED%95%98%EB%93%9C%EC%9B%A8%EC%96%B4-%EC%97%86%EB%8A%94-%ED%85%8C%EC%8A%A4%ED%8A%B8-%ED%99%98%EA%B2%BD-%EB%A7%8C%EB%93%A4%EA%B8%B0/#_1","title":"\ud55c\ub208\uc5d0 \ubcf4\uae30","text":"<p>| \uc800\uc7a5\uc18c | \uc8fc\uc694 \ubcc0\uacbd | | --- | --- | --- | | <code>util-scripts</code> | \uc7a5\uce58 \ud0d0\uc0c9\u00b7\uc0c1\ud0dc \uc870\ud68c \uc2a4\ud06c\ub9bd\ud2b8, XL430 \uc81c\uc5b4 \ud14c\uc774\ube14, \ud558\ub4dc\uc6e8\uc5b4 \uc548\uc804 \uac00\uc774\ub4dc | | <code>MockPortHandler</code> | Protocol 2.0/XL430 mock, \ud3ec\ud2b8 API, \ub2e8\uc704 \ud14c\uc2a4\ud2b8, \ud55c\u00b7\uc601 README |</p>"},{"location":"blog/2026/08/%EC%A7%80%EB%82%9C-2%EC%A3%BC-%EC%8B%A4%EC%A0%9C-dynamixel-%EC%A0%9C%EC%96%B4-%EA%B8%B0%EB%B0%98%EA%B3%BC-%ED%95%98%EB%93%9C%EC%9B%A8%EC%96%B4-%EC%97%86%EB%8A%94-%ED%85%8C%EC%8A%A4%ED%8A%B8-%ED%99%98%EA%B2%BD-%EB%A7%8C%EB%93%A4%EA%B8%B0/#util-scripts","title":"<code>util-scripts</code>","text":""},{"location":"blog/2026/08/%EC%A7%80%EB%82%9C-2%EC%A3%BC-%EC%8B%A4%EC%A0%9C-dynamixel-%EC%A0%9C%EC%96%B4-%EA%B8%B0%EB%B0%98%EA%B3%BC-%ED%95%98%EB%93%9C%EC%9B%A8%EC%96%B4-%EC%97%86%EB%8A%94-%ED%85%8C%EC%8A%A4%ED%8A%B8-%ED%99%98%EA%B2%BD-%EB%A7%8C%EB%93%A4%EA%B8%B0/#_2","title":"\ube0c\ub85c\ub4dc\uce90\uc2a4\ud2b8 \ud0d0\uc0c9\uacfc \uc0c1\ud0dc \uc2a4\uce94","text":"<p>\uba3c\uc800 DynamixelSDK\ub97c \ud504\ub85c\uc81d\ud2b8\uc5d0 \uc5f0\uacb0\ud558\uace0, \ub450 \uac00\uc9c0 \uc9c4\ub2e8 \uc2a4\ud06c\ub9bd\ud2b8\ub97c \ucd94\uac00\ud588\uc2b5\ub2c8\ub2e4.</p> <ul> <li><code>broadcast_ping.py</code>\ub294 Protocol 2.0\uc758 broadcast ping\uc73c\ub85c \uc5f0\uacb0\ub41c Dynamixel\uc758 ID, \ubaa8\ub378\u00b7\ud38c\uc6e8\uc5b4 \ubc84\uc804\uc744 \uc8fc\uae30\uc801\uc73c\ub85c \ubcf4\uc5ec \uc90d\ub2c8\ub2e4.</li> <li><code>scan_servo.py</code>\ub294 \uc5ec\ub7ec baud rate\uc640 ID \ubc94\uc704\ub97c \uc21c\ud68c\ud558\uba70 \uc7a5\uce58\ub97c \ucc3e\uace0, \ubc1c\uacac\ud55c \uc7a5\uce58\uc758 \uc704\uce58\u00b7\uc18d\ub3c4\u00b7\uc804\uc555\u00b7\uc628\ub3c4\u00b7\uc774\ub3d9 \uc0c1\ud0dc\u00b7\ud558\ub4dc\uc6e8\uc5b4 \uc624\ub958 \uc0c1\ud0dc\ub97c \uc77d\uc2b5\ub2c8\ub2e4.</li> </ul>"},{"location":"blog/2026/08/%EC%A7%80%EB%82%9C-2%EC%A3%BC-%EC%8B%A4%EC%A0%9C-dynamixel-%EC%A0%9C%EC%96%B4-%EA%B8%B0%EB%B0%98%EA%B3%BC-%ED%95%98%EB%93%9C%EC%9B%A8%EC%96%B4-%EC%97%86%EB%8A%94-%ED%85%8C%EC%8A%A4%ED%8A%B8-%ED%99%98%EA%B2%BD-%EB%A7%8C%EB%93%A4%EA%B8%B0/#wsl","title":"\uba85\ub839\uc904 \uc778\uc790\uc640 WSL \ud658\uacbd \uc124\uc815","text":"<p>\uc2a4\ud06c\ub9bd\ud2b8\uc5d0 Windows\u00b7macOS\u00b7Linux/WSL\ubcc4 \uae30\ubcf8 \uc2dc\ub9ac\uc5bc \ud3ec\ud2b8 \uc120\ud0dd\uacfc <code>--port</code>, <code>--baudrate</code>, <code>--max-id</code> \uc778\uc790\ub97c \ucd94\uac00\ud588\uc2b5\ub2c8\ub2e4.</p> <p>WSL \ud658\uacbd\uc744 \uace0\ub824\ud574 \uc758\uc874\uc131\uacfc <code>.gitignore</code>\ub3c4 \uc815\ub9ac\ud588\uc2b5\ub2c8\ub2e4.</p>"},{"location":"blog/2026/08/%EC%A7%80%EB%82%9C-2%EC%A3%BC-%EC%8B%A4%EC%A0%9C-dynamixel-%EC%A0%9C%EC%96%B4-%EA%B8%B0%EB%B0%98%EA%B3%BC-%ED%95%98%EB%93%9C%EC%9B%A8%EC%96%B4-%EC%97%86%EB%8A%94-%ED%85%8C%EC%8A%A4%ED%8A%B8-%ED%99%98%EA%B2%BD-%EB%A7%8C%EB%93%A4%EA%B8%B0/#xl430","title":"XL430 \uc81c\uc5b4 \ud14c\uc774\ube14 \uc815\uc758","text":"<p>\uc81c\uc5b4 \ud14c\uc774\ube14 \uc8fc\uc18c\uc640 \ub370\uc774\ud130 \uae38\uc774\ub97c <code>IntEnum</code>\uc73c\ub85c \uc815\uc758\ud588\uc2b5\ub2c8\ub2e4. <code>PRESENT_POSITION</code>, <code>GOAL_POSITION</code>, <code>TORQUE_ENABLE</code> \ub4f1\uc758 \ub808\uc9c0\uc2a4\ud130 \uc774\ub984\uc744 \ud3ec\ud568\ud588\uc2b5\ub2c8\ub2e4.</p> <p>\uc774\ubc88\uc5d0\ub294 \uae30\ubcf8\uc801\uc778 \uc0c1\ud0dc\u00b7\ubaa9\ud45c\uac12 \ub808\uc9c0\uc2a4\ud130 \uc678\uc5d0\ub3c4 \ub2e4\uc74c \ud29c\ub2dd\u00b7\ubcf4\ud638 \ud56d\ubaa9\uc744 \uc8fc\uc11d\uc73c\ub85c \uc815\ub9ac\ud588\uc2b5\ub2c8\ub2e4.</p> <ul> <li>\uc704\uce58 P \uac8c\uc778\uacfc \ud5a5\ud6c4 PID/\ud53c\ub4dc\ud3ec\uc6cc\ub4dc \ud29c\ub2dd \ud56d\ubaa9</li> <li>\uc804\uc555\u00b7\uc628\ub3c4 \uc81c\ud55c \ubc0f \ud558\ub4dc\uc6e8\uc5b4 \uc624\ub958 \uc2dc \uc885\ub8cc \uc870\uac74</li> <li>\ud1b5\uc2e0 \ub2e8\uc808 \uc2dc \ud1a0\ud06c \ucc28\ub2e8\uc5d0 \ud65c\uc6a9\ud560 \uc218 \uc788\ub294 bus watchdog</li> </ul>"},{"location":"blog/2026/08/%EC%A7%80%EB%82%9C-2%EC%A3%BC-%EC%8B%A4%EC%A0%9C-dynamixel-%EC%A0%9C%EC%96%B4-%EA%B8%B0%EB%B0%98%EA%B3%BC-%ED%95%98%EB%93%9C%EC%9B%A8%EC%96%B4-%EC%97%86%EB%8A%94-%ED%85%8C%EC%8A%A4%ED%8A%B8-%ED%99%98%EA%B2%BD-%EB%A7%8C%EB%93%A4%EA%B8%B0/#_3","title":"\ud558\ub4dc\uc6e8\uc5b4 \uc548\uc804 \uac00\uc774\ub4dc \uc791\uc131","text":"<p><code>dynamixel_hardware_guide.md</code>\uc5d0 \uc804\uc6d0 \uc778\uac00 \uc0c1\ud0dc\uc5d0\uc11c \ucf00\uc774\ube14\uc744 \ub9cc\uc9c0\uc9c0 \uc54a\uae30, 7\uac1c \ubaa8\ud130\uc758 \uc804\ub958\ub97c \uace0\ub824\ud55c \uc804\uc6d0 \ub77c\uc778 \ubd84\uc0b0, \ub300\uae30 \uc911 \uc804\uc6d0 \ucc28\ub2e8, \ud1a0\ud06c\uac00 \uac78\ub9b0 \uad00\uc808\uc5d0 \uc678\ub825\uc744 \uac00\ud558\uc9c0 \uc54a\uae30 \ub4f1\uc758 \uc218\uce59\uc744 \uc815\ub9ac\ud588\uc2b5\ub2c8\ub2e4.</p> <p>\uc804\uc6d0 ON \u2192 \ud3ec\ud2b8 \uac1c\ubc29\u00b7ping \uac80\uc99d \u2192 \uc81c\uc5b4 \u2192 \ud1a0\ud06c \ud574\uc81c\uc640 \ud3ec\ud2b8 \uc885\ub8cc \u2192 \uc804\uc6d0 OFF \uc21c\uc11c\uc758 \uc81c\uc5b4 \ub8e8\ud2f4\uc744 \ubb38\uc11c\ud654\ud588\uc2b5\ub2c8\ub2e4. \uc7a5\uce58 \ud0d0\uc0c9 \uc2a4\ud06c\ub9bd\ud2b8\uc5d0\ub294 <code>SIGINT</code> \ucc98\ub9ac\ub85c \ud3ec\ud2b8\ub97c \ub2eb\ub294 \uc815\ub9ac \uacbd\ub85c\ub3c4 \ucd94\uac00\ud588\uc2b5\ub2c8\ub2e4.</p>"},{"location":"blog/2026/08/%EC%A7%80%EB%82%9C-2%EC%A3%BC-%EC%8B%A4%EC%A0%9C-dynamixel-%EC%A0%9C%EC%96%B4-%EA%B8%B0%EB%B0%98%EA%B3%BC-%ED%95%98%EB%93%9C%EC%9B%A8%EC%96%B4-%EC%97%86%EB%8A%94-%ED%85%8C%EC%8A%A4%ED%8A%B8-%ED%99%98%EA%B2%BD-%EB%A7%8C%EB%93%A4%EA%B8%B0/#mockporthandler","title":"<code>MockPortHandler</code>","text":"<p><code>MockPortHandler</code>\uc5d0\uc11c\ub294 DynamixelSDK\uc758 \ud3ec\ud2b8 \uacc4\uce35\uc744 \ubcf8\ub72c \uba54\ubaa8\ub9ac \uae30\ubc18 \ud3ec\ud2b8\uc640 XL430 \uc720\uc0ac \uc7a5\uce58\ub97c \uad6c\ud604\ud588\uc2b5\ub2c8\ub2e4. \ud3ec\ud2b8\ub97c \uc5f4\uba74 \uae30\ubcf8 mock \uc7a5\uce58\uac00 \uc0dd\uc131\ub418\uace0, \ud328\ud0b7\uc744 \uc4f0\uba74 \ud574\ub2f9 \uc7a5\uce58\uac00 \ucc98\ub9ac\ud55c Status Packet\uc744 \uc77d\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p>"},{"location":"blog/2026/08/%EC%A7%80%EB%82%9C-2%EC%A3%BC-%EC%8B%A4%EC%A0%9C-dynamixel-%EC%A0%9C%EC%96%B4-%EA%B8%B0%EB%B0%98%EA%B3%BC-%ED%95%98%EB%93%9C%EC%9B%A8%EC%96%B4-%EC%97%86%EB%8A%94-%ED%85%8C%EC%8A%A4%ED%8A%B8-%ED%99%98%EA%B2%BD-%EB%A7%8C%EB%93%A4%EA%B8%B0/#protocol-20","title":"Protocol 2.0 \ud328\ud0b7 \ucc98\ub9ac \uad6c\ud604","text":"<ul> <li>\ud1b5\uc2e0 \uc0c1\uc218\uc640 CRC-16 \uacc4\uc0b0</li> <li>\ud328\ud0b7 \ud30c\uc2f1\u00b7\uae38\uc774 \uac80\uc99d\u00b7byte stuffing</li> <li>Status Packet \uc0dd\uc131\uacfc CRC \uac80\uc99d</li> <li><code>PING</code>, <code>READ</code>, <code>WRITE</code>, <code>REG_WRITE</code>, <code>ACTION</code>, <code>REBOOT</code>, <code>FACTORY_RESET</code> instruction \ucc98\ub9ac</li> <li>broadcast PING\uc758 \uc751\ub2f5\uacfc broadcast WRITE/REG_WRITE\uc758 \ubb34\uc751\ub2f5 \uaddc\uce59</li> </ul> <p><code>MockXL430</code>\uc740 \ubaa8\ub378 \ubc88\ud638, \ud38c\uc6e8\uc5b4 \ubc84\uc804, \ud1a0\ud06c \ud65c\uc131\ud654, \ubaa9\ud45c \uc704\uce58 \ub4f1\uc758 \uc81c\uc5b4 \ud14c\uc774\ube14 \uc0c1\ud0dc\ub97c \uba54\ubaa8\ub9ac\uc5d0 \ubcf4\uad00\ud569\ub2c8\ub2e4.</p>"},{"location":"blog/2026/08/%EC%A7%80%EB%82%9C-2%EC%A3%BC-%EC%8B%A4%EC%A0%9C-dynamixel-%EC%A0%9C%EC%96%B4-%EA%B8%B0%EB%B0%98%EA%B3%BC-%ED%95%98%EB%93%9C%EC%9B%A8%EC%96%B4-%EC%97%86%EB%8A%94-%ED%85%8C%EC%8A%A4%ED%8A%B8-%ED%99%98%EA%B2%BD-%EB%A7%8C%EB%93%A4%EA%B8%B0/#_4","title":"\ub2e8\uc704 \ud14c\uc2a4\ud2b8 \ucd94\uac00","text":"<p>\ud328\ud0b7 \uc0dd\uc131\uacfc Status Packet \uac80\uc99d\uc744 \uc704\ud55c \ud14c\uc2a4\ud2b8 \ud5ec\ud37c\ub97c \ucd94\uac00\ud558\uace0, \ub2e4\uc74c \ubc94\uc704\uc758 \ub2e8\uc704 \ud14c\uc2a4\ud2b8 21\uac1c\ub97c \ucd94\uac00\ud588\uc2b5\ub2c8\ub2e4.</p> <ul> <li>\ud3ec\ud2b8 \uc5f4\uae30\u00b7\ub2eb\uae30, baud rate, \ubc84\ud37c \ube44\uc6b0\uae30, \ud0c0\uc784\uc544\uc6c3</li> <li>ping\uacfc \ubaa8\ub378/\ud38c\uc6e8\uc5b4 \uc815\ubcf4 \uc77d\uae30</li> <li>\ud1a0\ud06c\uc640 \ubaa9\ud45c \uc704\uce58 \uc4f0\uae30 \ubc0f \uc77d\uae30</li> <li>\uc798\ubabb\ub41c \ub300\uc0c1 ID\uc640 \uc798\ubabb\ub41c READ \ud328\ud0b7 \ucc98\ub9ac</li> <li>byte stuffing \uc774\ud6c4\uc758 CRC \uac80\uc99d</li> <li><code>REG_WRITE</code> \ud6c4 <code>ACTION</code>, <code>REBOOT</code>, broadcast \ub3d9\uc791</li> </ul>"},{"location":"blog/archive/2026/","title":"2026","text":""},{"location":"blog/category/yeonjunky/","title":"yeonjunky","text":""},{"location":"blog/category/erdoslibrary/","title":"erdoslibrary","text":""}]}